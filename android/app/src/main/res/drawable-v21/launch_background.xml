<?xml version="1.0" encoding="utf-8"?>
<!-- Modify this file to customize your launch splash screen -->
<!-- Mismo tamaño fijo que drawable/launch_background.xml — ver el comentario
     ahí sobre por qué el logo salía gigante en Android TV. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="center"
        android:drawable="@drawable/launch_logo" />
</layer-list>
