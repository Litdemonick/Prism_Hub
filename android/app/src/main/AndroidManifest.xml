<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Huella/rostro para la Zona +18 (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="PrismHub"
        android:name="${applicationName}"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlaces compartidos: prismhub://detail?package=...&url=...
                 BROWSABLE es lo que permite que lo abra otra app (WhatsApp,
                 el navegador); sin esa categoria el enlace se ve como texto
                 muerto. DEFAULT hace falta para que el sistema lo resuelva
                 sin que nadie nombre la actividad a mano. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="prismhub" android:host="detail" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller activado (default desde Flutter 3.29+): renderiza con
             Vulkan en GPU compatible, elimina los tirones de compilación de
             shaders y reduce drásticamente el raster time. El opt-out a Skia
             está deprecado y será eliminado en una versión futura de Flutter.
             Si aparecen artefactos visuales raros, reportar el bug a Flutter
             en vez de re-desactivar. -->
        <!-- FileProvider para instalar APK automáticamente en Android 7.0+ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- connectivity_plus necesita esto para checkConnectivity()/
         onConnectivityChanged en Android — sin él, el banner de "sin
         conexión" quedaba pegado en el valor inicial para siempre (el
         plugin falla silenciosamente y no hay forma de detectar un
         cambio real de red sin reiniciar la app). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Permiso necesario para instalar APK automáticamente en Android 8.0+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Permiso para leer archivos del sistema de archivos para el APK -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

</manifest>