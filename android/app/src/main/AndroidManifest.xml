<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Huella/rostro para la Zona +18 (local_auth). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- enableOnBackInvokedCallback: el gesto de atras predictivo de Android
         13+. Sin el, el sistema avisa en cada arranque que no esta habilitado
         y no se ve la animacion de vuelta que el usuario ya espera del resto
         del telefono. -->
    <!-- No excluye el APK de dispositivos táctiles: los dos van con
         required="false". Sin esto, un Play Store real podría dejar de
         ofrecer la app a teléfonos normales al declarar soporte de TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:banner="@drawable/banner_tv"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- LEANBACK_LAUNCHER es lo que hace que el ícono (con el banner
                 de arriba) aparezca en el selector de apps de Android TV. Se
                 SUMA al intent-filter de arriba, no lo reemplaza: el mismo
                 APK sigue instalando y abriendo igual en teléfono/tablet. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Enlaces compartidos: prismhub://detail?package=...&url=...
                 BROWSABLE es lo que permite que lo abra otra app (WhatsApp,
                 el navegador); sin esa categoria el enlace se ve como texto
                 muerto. DEFAULT hace falta para que el sistema lo resuelva
                 sin que nadie nombre la actividad a mano. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="prismhub" android:host="detail" />
            </intent-filter>
            <!-- El mismo enlace, pero en https: es el que se comparte por chat,
                 porque WhatsApp no hace tocables los esquemas propios de una
                 app. autoVerify hace que Android lo abra DIRECTO en PrismHub en
                 vez de pasar por el navegador, siempre que el sitio publique su
                 assetlinks.json; sin eso sigue funcionando, solo que preguntando
                 con que abrirlo. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="litdemonick.github.io"
                      android:pathPrefix="/Prism_Hub/abrir" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller activado (default desde Flutter 3.29+): renderiza con
             Vulkan en GPU compatible, elimina los tirones de compilación de
             shaders y reduce drásticamente el raster time. El opt-out a Skia
             está deprecado y será eliminado en una versión futura de Flutter.
             Si aparecen artefactos visuales raros, reportar el bug a Flutter
             en vez de re-desactivar. -->
        <!-- FileProvider para instalar APK automáticamente en Android 7.0+ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Notificación del reproductor (audio_service).
             Deja seguir viendo o transmitiendo con la app en segundo plano, y
             controlarlo desde la barra sin volver a entrar. Transmitiendo a un
             televisor es donde más se nota: la imagen está en la otra pantalla
             y el teléfono es el mando. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- Los botones de la notificación y los de los auriculares llegan
             por acá. Sin esto la notificación se dibuja pero no responde. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- connectivity_plus necesita esto para checkConnectivity()/
         onConnectivityChanged en Android — sin él, el banner de "sin
         conexión" quedaba pegado en el valor inicial para siempre (el
         plugin falla silenciosamente y no hay forma de detectar un
         cambio real de red sin reiniciar la app). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Permiso necesario para instalar APK automáticamente en Android 8.0+ -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Permiso para leer archivos del sistema de archivos para el APK -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- La notificación del reproductor. Desde Android 13 el sistema pide
         permiso para mostrar cualquier notificación; sin el primero, la barra
         de controles no aparece nunca. El segundo es lo que permite que la
         reproducción siga con la app en segundo plano en vez de que el sistema
         la corte a los pocos segundos. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

</manifest>